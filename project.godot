; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited via a text editor.

[application]

config/name="Hospital Tycoon"
config/description="A hospital management tycoon game with real-world healthcare economics"
config/version="1.0.0"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameConstants="*res://scripts/data/game_constants.gd"
DepartmentDefs="*res://scripts/data/department_definitions.gd"
RoomDefs="*res://scripts/data/room_definitions.gd"
EquipmentCatalog="*res://scripts/data/equipment_catalog.gd"
StaffTemplates="*res://scripts/data/staff_templates.gd"
DiseaseDefs="*res://scripts/data/disease_database.gd"
SymptomDB="*res://scripts/data/symptom_database.gd"
InsuranceDefs="*res://scripts/data/insurance_data.gd"
CPTCodeDB="*res://scripts/data/cpt_codes.gd"
SaveManager="*res://scripts/services/save_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

