func get_all_diseases() -> Array:
	return all_diseases


func find_by_id(disease_id: String) -> Dictionary:
	for disease in all_diseases:
		if disease.get("id") == disease_id:
			return disease
	return {}


func get_diseases_for_department(dept: RoomData.Department) -> Array:
	var results: Array = []
	for disease in all_diseases:
		if disease.get("department") == dept:
			results.append(disease)
	return results
